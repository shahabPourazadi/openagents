# =============================================================================
# OpenAgents API — env example
# Copy to apps/api/.env (or repo root .env). Local Compose defaults to open auth + SQLite.
# =============================================================================

# --- Core ---
APP_ENV=local
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
OPENROUTER_API_KEY=
# AUTH_MODE=none (open/single-user) | supabase (require Bearer JWT)
AUTH_MODE=none
# Deprecated: AUTH_BYPASS=true → none, false → supabase (ignored when AUTH_MODE set)
# AUTH_BYPASS=true
# App DB (threads/chats). Auth and DB are independent — see docs/configuration.md
DATABASE_URL=sqlite+aiosqlite:///./openagents.db
# Optional Postgres overrides (APP_ENV=local uses LOCAL, production uses PRODUCTION)
# DATABASE_URL_LOCAL=postgresql+asyncpg://user:pass@127.0.0.1:54322/postgres
# DATABASE_URL_PRODUCTION=postgresql+asyncpg://user:pass@db:5432/postgres
DEFAULT_MODEL=openrouter:anthropic/claude-sonnet-5
DEEP_AGENT_ENABLED=true
WORKSPACE_TMP_ROOT=/tmp/openagents-workspaces
LITEPARSE_OCR_LANGUAGE=en

# --- Agent sandbox ---
AGENT_SANDBOX=local
AGENT_EXECUTE=true
AGENT_SANDBOX_MAX_CONCURRENT=1
AGENT_SANDBOX_IMAGE=openagents-agent-sandbox:latest

# --- Optional MCP ---
# FIRECRAWL_API_KEY=
# MCP_SERVERS_JSON=[{"name":"firecrawl","url":"https://mcp.firecrawl.dev/v2/mcp","auth_env":"FIRECRAWL_API_KEY","allowlist":["firecrawl_search","firecrawl_scrape","firecrawl_crawl"]}]

# --- Optional Supabase auth (AUTH_MODE=supabase). Does not move SQLite chats. ---
# SUPABASE_URL=https://base.example.com
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_JWT_SECRET=

# --- Optional signup queue (default OFF — users auto-activate) ---
FEATURE_SIGNUP_QUEUE=false
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=OpenAgents <noreply@example.com>

# --- Optional observability ---
LOGFIRE_TOKEN=
LOGFIRE_ENABLED=false
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://tele.example.com
# LANGFUSE_OTEL_ENDPOINT=

# --- Optional S3 (omit to use local openagents-uploads/) ---
# OPENAGENTS_S3_ENDPOINT=https://s3.example.com
# OPENAGENTS_S3_REGION=garage
# OPENAGENTS_S3_BUCKET=openagents-uploads
# OPENAGENTS_S3_ACCESS_KEY_ID=
# OPENAGENTS_S3_SECRET_ACCESS_KEY=
# OPENAGENTS_S3_FORCE_PATH_STYLE=true
# OPENAGENTS_S3_SSE_C_KEY_BASE64=

# --- Spend budget ---
DEFAULT_SPEND_BUDGET_USD=5.0
